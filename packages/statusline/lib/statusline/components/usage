#!/usr/bin/env bash
# Description: Shows 5h and weekly quota usage with countdown timers and context window
#
# Reads agy telemetry JSON from stdin and prints usage metrics.

INPUT=$(cat)
if [ -z "$INPUT" ]; then
  exit 0
fi

# Color definitions
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
DIM="\033[2m"
RESET="\033[0m"

# Format remaining seconds into a concise human string (e.g., "3h 45m", "4d 1h", "22m")
format_countdown() {
  local SECS="$1"
  if [ -z "$SECS" ] || [ "$SECS" -le 0 ] 2>/dev/null; then
    echo "now"
    return
  fi

  local DAYS=$((SECS / 86400))
  local HOURS=$(((SECS % 86400) / 3600))
  local MINS=$(((SECS % 3600) / 60))

  if [ "$DAYS" -gt 0 ]; then
    if [ "$HOURS" -gt 0 ]; then
      echo "${DAYS}d ${HOURS}h"
    else
      echo "${DAYS}d"
    fi
  elif [ "$HOURS" -gt 0 ]; then
    if [ "$MINS" -gt 0 ]; then
      echo "${HOURS}h ${MINS}m"
    else
      echo "${HOURS}h"
    fi
  else
    echo "${MINS}m"
  fi
}

get_quota_color() {
  local VAL="$1"
  if [ -z "$VAL" ]; then
    echo "$DIM"
  elif [ "$VAL" -ge 50 ]; then
    echo "$GREEN"
  elif [ "$VAL" -ge 20 ]; then
    echo "$YELLOW"
  else
    echo "$RED"
  fi
}

get_context_color() {
  local VAL="$1"
  if [ -z "$VAL" ]; then
    echo "$DIM"
  elif [ "$VAL" -lt 60 ]; then
    echo "$GREEN"
  elif [ "$VAL" -lt 85 ]; then
    echo "$YELLOW"
  else
    echo "$RED"
  fi
}

# Extract telemetry metrics with active-model auto-detection
METRICS=$(echo "$INPUT" | jq -r '
  ((.model.display_name // .model.id // "") | ascii_downcase) as $raw_m |
  (
    if $raw_m == "" then "none"
    elif ($raw_m | contains("argon")) then "argon"
    elif ($raw_m | (contains("claude") or contains("sonnet") or contains("opus") or contains("3p"))) then "3p"
    elif ($raw_m | contains("gemini")) then "gemini"
    else "other"
    end
  ) as $family |
  ([ (.quota // {}) | to_entries[] |
     {
       key: .key,
       val: .value,
       k: (.key | ascii_downcase),
       win: (((.value.window // "") | tostring) | ascii_downcase)
     } |
     . + {
       is_5h: ((.k | contains("5h")) or (.win == "5h")),
       is_weekly: ((.k | (contains("weekly") or contains("7d") or contains("1w"))) or (.win | (. == "weekly" or . == "7d" or . == "1w")))
     }
  ]) as $entries |
  
  # Resolve 5h object
  (
    if $family == "argon" then
      (($entries | map(select((.k | contains("argon")) and .is_5h))[0].val) // null)
    elif $family == "3p" then
      (($entries | map(select((.k | (contains("3p") or contains("claude") or contains("sonnet") or contains("opus"))) and .is_5h))[0].val) //
       .quota["3p-5h"] // .quota["claude-5h"] //
       ($entries | map(select(.is_5h))[0].val) // null)
    elif $family == "gemini" then
      (($entries | map(select((.k | contains("gemini")) and (.k | contains("argon") | not) and .is_5h))[0].val) //
       .quota["gemini-5h"] //
       ($entries | map(select(.is_5h))[0].val) // null)
    elif $family == "other" then
      (($entries | map(select(. as $e | (($e.k | contains($raw_m)) or ($raw_m | contains($e.k))) and $e.is_5h))[0].val) //
       ($entries | map(select(.is_5h))[0].val) // null)
    else
      (.quota["gemini-5h"] // .quota["3p-5h"] // ($entries | map(select(.is_5h))[0].val) // null)
    end
  ) as $q_5h |
  
  # Resolve weekly object
  (
    if $family == "argon" then
      (($entries | map(select((.k | contains("argon")) and .is_weekly))[0].val) //
       ($entries | map(select(.k | contains("argon")))[0].val) //
       (if ($entries | map(select(.is_weekly)) | length == 1) then ($entries | map(select(.is_weekly))[0].val) else null end) //
       .quota["gemini-weekly"] //
       null)
    elif $family == "3p" then
      (($entries | map(select((.k | (contains("3p") or contains("claude") or contains("sonnet") or contains("opus"))) and .is_weekly))[0].val) //
       .quota["3p-weekly"] // .quota["claude-weekly"] //
       ($entries | map(select(.is_weekly))[0].val) // null)
    elif $family == "gemini" then
      (($entries | map(select((.k | contains("gemini")) and (.k | contains("argon") | not) and .is_weekly))[0].val) //
       .quota["gemini-weekly"] //
       ($entries | map(select(.is_weekly))[0].val) // null)
    elif $family == "other" then
      (($entries | map(select(. as $e | (($e.k | contains($raw_m)) or ($raw_m | contains($e.k))) and $e.is_weekly))[0].val) //
       ($entries | map(select(.is_weekly))[0].val) // null)
    else
      (.quota["gemini-weekly"] // .quota["3p-weekly"] // ($entries | map(select(.is_weekly))[0].val) // null)
    end
  ) as $q_wk |

  (if ($q_5h != null and $q_5h.remaining_fraction != null) then ($q_5h.remaining_fraction * 100 | round) else "" end) as $f5_pct |
  (if ($q_5h != null and $q_5h.reset_in_seconds != null) then $q_5h.reset_in_seconds else "" end) as $f5_rst |
  (if ($q_wk != null and $q_wk.remaining_fraction != null) then ($q_wk.remaining_fraction * 100 | round) else "" end) as $wk_pct |
  (if ($q_wk != null and $q_wk.reset_in_seconds != null) then $q_wk.reset_in_seconds else "" end) as $wk_rst |
  (if (.context_window != null and .context_window.used_percentage != null) then (.context_window.used_percentage | round) else "" end) as $ctx_pct |

  [$f5_pct, $f5_rst, $wk_pct, $wk_rst, $ctx_pct] | map(tostring) | join("|")
' 2>/dev/null)

IFS="|" read -r FIVE_HOUR_PCT FIVE_HOUR_RESET WEEKLY_PCT WEEKLY_RESET CTX_PCT <<< "$METRICS"

PARTS=()

if [ -n "$FIVE_HOUR_PCT" ]; then
  C5H=$(get_quota_color "$FIVE_HOUR_PCT")
  RESET_STR=""
  if [ -n "$FIVE_HOUR_RESET" ] && [ "$FIVE_HOUR_RESET" -gt 0 ] 2>/dev/null; then
    COUNTDOWN=$(format_countdown "$FIVE_HOUR_RESET")
    RESET_STR=" ${DIM}(${COUNTDOWN})${RESET}"
  fi
  PARTS+=("${DIM}5h:${RESET} ${C5H}${FIVE_HOUR_PCT}%${RESET}${RESET_STR}")
fi

if [ -n "$WEEKLY_PCT" ]; then
  CWK=$(get_quota_color "$WEEKLY_PCT")
  RESET_STR=""
  if [ -n "$WEEKLY_RESET" ] && [ "$WEEKLY_RESET" -gt 0 ] 2>/dev/null; then
    COUNTDOWN=$(format_countdown "$WEEKLY_RESET")
    RESET_STR=" ${DIM}(${COUNTDOWN})${RESET}"
  fi
  PARTS+=("${DIM}Wk:${RESET} ${CWK}${WEEKLY_PCT}%${RESET}${RESET_STR}")
fi

if [ -n "$CTX_PCT" ]; then
  CCTX=$(get_context_color "$CTX_PCT")
  PARTS+=("${CCTX}${CTX_PCT}%${RESET} ${DIM}ctx${RESET}")
fi

if [ ${#PARTS[@]} -gt 0 ]; then
  RESULT_JOINED=""
  for p in "${PARTS[@]}"; do
    if [ -z "$RESULT_JOINED" ]; then
      RESULT_JOINED="$p"
    else
      RESULT_JOINED="$RESULT_JOINED, $p"
    fi
  done
  printf "[%b]" "$RESULT_JOINED"
fi
